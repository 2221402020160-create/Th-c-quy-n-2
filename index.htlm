<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thẻ Đặc Quyền Lớp Học - 3D Custom Themes</title>
    <!-- Pháo hoa Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Mali:wght@600;700&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        /* Default Theme: Cosmic Night */
        :root {
            --bg-gradient: radial-gradient(circle at center, #2b134d 0%, #0a0515 100%);
            --banner-bg: linear-gradient(90deg, #ff0844 0%, #ffb199 100%);
            --banner-shadow: rgba(255, 8, 68, 0.6);
            --card-back-bg: linear-gradient(145deg, #7028e8 0%, #3e1b73 50%, #170933 100%);
            --card-halo: radial-gradient(circle, rgba(255,230,0,0.8) 0%, rgba(255,230,0,0) 70%);
            --accent-color: #ffe600;
            --btn-start-bg: linear-gradient(135deg, #00c6fb 0%, #005bea 100%);
            --text-color: #ffffff;
            --modal-bg: #221538;
            --modal-border: #8c52ff;
        }

        /* Theme 2: Classroom Playful */
        body.theme-classroom {
            --bg-gradient: radial-gradient(circle at center, #1b4d3e 0%, #061c15 100%);
            --banner-bg: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
            --banner-shadow: rgba(56, 239, 125, 0.5);
            --card-back-bg: linear-gradient(145deg, #0d7355 0%, #07402f 50%, #032118 100%);
            --card-halo: radial-gradient(circle, rgba(56, 239, 125, 0.8) 0%, rgba(56, 239, 125, 0) 70%);
            --btn-start-bg: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            --modal-bg: #0d2b22;
            --modal-border: #38ef7d;
        }

        /* Theme 3: Candy Cute */
        body.theme-candy {
            --bg-gradient: radial-gradient(circle at center, #591d48 0%, #1f0518 100%);
            --banner-bg: linear-gradient(90deg, #ff9a9e 0%, #fecfef 100%);
            --banner-shadow: rgba(255, 154, 158, 0.6);
            --card-back-bg: linear-gradient(145deg, #d63384 0%, #851c50 50%, #3d0823 100%);
            --card-halo: radial-gradient(circle, rgba(254, 207, 239, 0.8) 0%, rgba(254, 207, 239, 0) 70%);
            --btn-start-bg: linear-gradient(135deg, #ff758c 0%, #ff7eb3 100%);
            --modal-bg: #38122c;
            --modal-border: #ff7eb3;
        }

        /* Theme 4: Sunset Glow */
        body.theme-sunset {
            --bg-gradient: radial-gradient(circle at center, #4d1938 0%, #170412 100%);
            --banner-bg: linear-gradient(90deg, #ff512f 0%, #f09819 100%);
            --banner-shadow: rgba(255, 81, 47, 0.6);
            --card-back-bg: linear-gradient(145deg, #c0392b 0%, #7b241c 50%, #380b07 100%);
            --card-halo: radial-gradient(circle, rgba(240, 152, 25, 0.8) 0%, rgba(240, 152, 25, 0) 70%);
            --btn-start-bg: linear-gradient(135deg, #ff512f 0%, #f09819 100%);
            --modal-bg: #330f24;
            --modal-border: #ff512f;
        }

        /* Theme 5: Deep Ocean */
        body.theme-ocean {
            --bg-gradient: radial-gradient(circle at center, #0f3443 0%, #031017 100%);
            --banner-bg: linear-gradient(90deg, #3a7bd5 0%, #3a57a6 100%);
            --banner-shadow: rgba(58, 123, 213, 0.6);
            --card-back-bg: linear-gradient(145deg, #1f509a 0%, #0d2852 50%, #041024 100%);
            --card-halo: radial-gradient(circle, rgba(0, 210, 255, 0.8) 0%, rgba(0, 210, 255, 0) 70%);
            --btn-start-bg: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
            --modal-bg: #0b2230;
            --modal-border: #00d2ff;
        }

        body {
            font-family: 'Mali', cursive, sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 15px;
            overflow-x: hidden;
            color: var(--text-color);
            transition: background 0.6s ease;
        }

        /* Banner tiêu đề */
        .title-banner {
            background: var(--banner-bg);
            color: #fff;
            padding: 10px 40px;
            border-radius: 50px;
            font-size: 2rem;
            font-weight: 700;
            text-transform: uppercase;
            box-shadow: 0 0 25px var(--banner-shadow), inset 0 -4px 0 rgba(0,0,0,0.2);
            border: 4px solid #fff;
            margin-bottom: 10px;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.4);
            animation: bannerFloat 3s ease-in-out infinite alternate;
            text-align: center;
        }

        @keyframes bannerFloat {
            from { transform: translateY(0); }
            to { transform: translateY(-5px); }
        }

        /* Sân khấu 3D lơ lửng */
        .arena-container {
            position: relative;
            width: 100vw;
            max-width: 1350px;
            height: 540px;
            perspective: 1600px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Thẻ bao ngoài */
        .card-wrapper {
            position: absolute;
            width: 180px;
            height: 250px;
            perspective: 1200px;
            cursor: pointer;
            transition: opacity 0.5s ease, filter 0.3s;
            will-change: transform;
        }

        /* Khối lật 3D (Flip Card) */
        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            border-radius: 24px;
            transform-style: preserve-3d;
            transition: transform 0.8s cubic-bezier(0.4, 0.2, 0.2, 1);
        }

        .card-wrapper.flipped .card-inner {
            transform: rotateY(180deg);
        }

        /* Mặt thẻ */
        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 24px;
            backface-visibility: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 18px 12px;
            border: 3px solid rgba(255, 255, 255, 0.95);
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.2), 0 10px 25px rgba(0,0,0,0.5);
        }

        /* Mặt úp: Biểu tượng Đặc Quyền */
        .card-back {
            background: var(--card-back-bg);
            animation: auraPulse 2.5s infinite alternate ease-in-out;
            overflow: hidden;
            transition: background 0.5s ease;
        }

        @keyframes auraPulse {
            0% { box-shadow: 0 0 15px rgba(255, 255, 255, 0.3), 0 0 30px rgba(255, 230, 0, 0.2); }
            100% { box-shadow: 0 0 30px rgba(255, 255, 255, 0.8), 0 0 55px rgba(255, 230, 0, 0.6); }
        }

        /* Khung chứa Icon/Ảnh đại diện mặt sau */
        .privilege-avatar-container {
            position: relative;
            width: 110px;
            height: 110px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 5px;
        }

        .privilege-halo {
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: var(--card-halo);
            animation: rotateHalo 6s linear infinite;
        }

        @keyframes rotateHalo {
            0% { transform: rotate(0deg) scale(0.95); }
            50% { transform: rotate(180deg) scale(1.08); }
            100% { transform: rotate(360deg) scale(0.95); }
        }

        .privilege-img {
            width: 95px;
            height: 95px;
            object-fit: contain;
            filter: drop-shadow(0 10px 15px rgba(0,0,0,0.4));
            animation: iconFloat 2.6s ease-in-out infinite alternate;
            z-index: 2;
        }

        .privilege-emoji {
            font-size: 4.8rem;
            line-height: 1;
            filter: drop-shadow(0 8px 12px rgba(0,0,0,0.4));
            animation: iconFloat 2.6s ease-in-out infinite alternate;
            z-index: 2;
        }

        @keyframes iconFloat {
            0% { transform: translateY(0px) rotate(0deg) scale(1); }
            50% { transform: translateY(-8px) rotate(3deg) scale(1.06); }
            100% { transform: translateY(4px) rotate(-3deg) scale(0.98); }
        }

        .card-badge-title {
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--accent-color);
            text-shadow: 0 2px 4px rgba(0,0,0,0.7);
            letter-spacing: 0.5px;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
            background: rgba(0, 0, 0, 0.3);
            padding: 3px 10px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .card-label {
            font-size: 1.05rem;
            font-weight: 700;
            color: #d63384;
            background: rgba(255, 255, 255, 0.95);
            padding: 4px 14px;
            border-radius: 30px;
            border: 2px dashed #d63384;
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        /* Mặt ngửa (Nội dung Quà) */
        .card-front {
            background: linear-gradient(145deg, #ffffff 0%, #fff0f5 100%);
            color: #333;
            transform: rotateY(180deg);
            padding: 20px 15px;
            text-align: center;
            border: 4px solid #ff477e;
            box-shadow: 0 0 35px #ffe600, 0 0 60px #ff7b00;
            justify-content: center;
            gap: 12px;
        }

        .card-front .reward-icon {
            font-size: 4rem;
            animation: bounceIcon 1s infinite alternate;
        }

        @keyframes bounceIcon {
            from { transform: translateY(0); }
            to { transform: translateY(-8px); }
        }

        .card-front .reward-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #d63384;
            line-height: 1.35;
        }

        /* Hiệu ứng khóa mục tiêu */
        .card-wrapper.targeted {
            filter: brightness(1.35);
            box-shadow: 0 0 45px #00f2fe, 0 0 80px #4facfe !important;
            z-index: 400 !important;
        }

        /* Thẻ chọn phóng to ra giữa */
        .card-wrapper.focus-center {
            z-index: 500 !important;
            transform: translate(0px, 0px) scale(1.48) !important;
            transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.3, 1) !important;
        }

        /* Thẻ bị loại trừ */
        .card-wrapper.eliminated {
            transform: scale(0) rotate(180deg) !important;
            opacity: 0 !important;
            pointer-events: none !important;
            transition: transform 0.5s ease, opacity 0.5s ease !important;
        }

        /* Nút điều khiển */
        .controls {
            margin-top: 15px;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
            z-index: 100;
        }

        .btn {
            padding: 12px 24px;
            font-family: inherit;
            font-size: 1.05rem;
            font-weight: 700;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            box-shadow: 0 6px 16px rgba(0,0,0,0.3);
            transition: all 0.25s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-start {
            background: var(--btn-start-bg);
            color: #fff;
            border: 2px solid #fff;
        }

        .btn-reset {
            background: rgba(255, 255, 255, 0.9);
            color: #333;
        }

        .btn-theme, .btn-config {
            background: rgba(255, 255, 255, 0.2);
            color: #fff;
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.4);
        }

        .btn:hover:not(:disabled) {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 8px 25px rgba(255,255,255,0.3);
        }

        .btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

        /* Modal Quà Nhận Được */
        .modal {
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background: rgba(0, 0, 0, 0.82);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            backdrop-filter: blur(8px);
        }

        .modal.active {
            display: flex;
            animation: fadeIn 0.3s forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-card {
            background: #fff;
            width: 90%;
            max-width: 460px;
            border-radius: 35px;
            border: 8px solid #ff477e;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 30px 60px rgba(0,0,0,0.6), 0 0 50px rgba(255, 71, 126, 0.6);
            animation: popUp 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes popUp {
            from { transform: scale(0.6); }
            to { transform: scale(1); }
        }

        .modal-header-tag {
            background: #ffe066;
            color: #d63384;
            padding: 8px 25px;
            border-radius: 20px;
            display: inline-block;
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 15px;
            border: 3px solid #ff922b;
        }

        .modal-emoji {
            font-size: 5rem;
            margin: 10px 0;
            animation: bounceEmoji 1.5s infinite ease-in-out;
        }

        @keyframes bounceEmoji {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }

        .modal-text {
            font-size: 1.75rem;
            font-weight: 700;
            color: #2b2d42;
            margin: 15px 0 25px 0;
            line-height: 1.4;
        }

        .btn-claim {
            background: #51cf66;
            color: white;
            border: none;
            font-family: inherit;
            font-size: 1.25rem;
            font-weight: 700;
            padding: 12px 36px;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 6px 18px rgba(81, 207, 102, 0.5);
            transition: all 0.2s;
        }

        .btn-claim:hover {
            transform: scale(1.06);
            background: #40c057;
        }

        /* Modal Cài Đặt Chung */
        .config-modal-card {
            background: var(--modal-bg);
            color: #fff;
            width: 90%;
            max-width: 720px;
            max-height: 88vh;
            border-radius: 25px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            border: 3px solid var(--modal-border);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .config-header {
            font-size: 1.5rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 15px;
            color: #ffb199;
        }

        /* Tabs Navigation trong Modal */
        .tab-container {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
            border-bottom: 2px solid rgba(255,255,255,0.1);
            padding-bottom: 8px;
        }

        .tab-btn {
            background: rgba(255,255,255,0.08);
            border: none;
            color: #fff;
            padding: 8px 18px;
            border-radius: 12px;
            font-family: inherit;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn.active {
            background: #ff477e;
            color: #fff;
            box-shadow: 0 4px 12px rgba(255, 71, 126, 0.4);
        }

        .tab-content {
            display: none;
            flex: 1;
            overflow-y: auto;
            padding-right: 5px;
        }

        .tab-content.active {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .config-item {
            display: flex;
            gap: 10px;
            align-items: center;
            background: rgba(255,255,255,0.06);
            padding: 10px 14px;
            border-radius: 14px;
        }

        .config-item .label-idx {
            font-weight: 700;
            color: #ffb199;
            min-width: 60px;
        }

        .config-item input.icon-input {
            width: 55px;
            text-align: center;
            font-size: 1.3rem;
            padding: 6px;
            border-radius: 8px;
            border: 1px solid #555;
            background: rgba(0,0,0,0.4);
            color: #fff;
        }

        .config-item input.text-input {
            flex: 1;
            padding: 8px 12px;
            font-family: inherit;
            font-size: 0.95rem;
            border-radius: 8px;
            border: 1px solid #555;
            background: rgba(0,0,0,0.4);
            color: #fff;
        }

        /* Grid hiển thị Themes */
        .theme-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
            padding: 5px;
        }

        .theme-card {
            background: rgba(255,255,255,0.08);
            border: 2px solid transparent;
            border-radius: 16px;
            padding: 12px;
            cursor: pointer;
            text-align: center;
            transition: all 0.25s;
        }

        .theme-card:hover {
            transform: translateY(-3px);
            background: rgba(255,255,255,0.15);
        }

        .theme-card.active {
            border-color: #ffe600;
            background: rgba(255,255,255,0.2);
            box-shadow: 0 0 15px rgba(255, 230, 0, 0.4);
        }

        .theme-preview {
            height: 50px;
            border-radius: 10px;
            margin-bottom: 8px;
        }

        .theme-card-name {
            font-weight: 700;
            font-size: 0.95rem;
        }

        .config-footer {
            margin-top: 15px;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .hint-text {
            font-size: 0.85rem;
            color: #ffb199;
            margin-bottom: 8px;
            line-height: 1.4;
        }
    </style>
</head>
<body>

    <div class="title-banner" id="mainTitle">⭐ THẺ ĐẶC QUYỀN LỚP HỌC ⭐</div>

    <!-- Sân khấu Quỹ đạo Elip 3D -->
    <div class="arena-container" id="arena"></div>

    <!-- Nút điều khiển -->
    <div class="controls">
        <button class="btn btn-start" id="startBtn" onclick="startShuffleAndAutoPick()">
            🚀 Bắt Đầu Quay & Chọn Thẻ
        </button>
        <button class="btn btn-reset" onclick="resetGame()">
            🔄 Đặt Lại Trò Chơi
        </button>
        <button class="btn btn-theme" onclick="openConfigModal('tab-themes')">
            🎨 Đổi Chủ Đề
        </button>
        <button class="btn btn-config" onclick="openConfigModal('tab-cards')">
            ⚙️ Cài Đặt Thẻ & Quà
        </button>
    </div>

    <!-- Modal Chi Tiết Quà -->
    <div class="modal" id="rewardModal">
        <div class="modal-card">
            <div class="modal-header-tag">✨ ĐẶC QUYỀN CỦA EM ✨</div>
            <div class="modal-emoji" id="rewardEmoji">👑</div>
            <div class="modal-text" id="rewardText">Được làm Lớp Trưởng trong 1 tuần</div>
            <button class="btn-claim" onclick="closeReward()">Nhận Thưởng 🎉</button>
        </div>
    </div>

    <!-- Modal Cài Đặt Đa Năng -->
    <div class="modal" id="configModal">
        <div class="config-modal-card">
            <div class="config-header">⚙️ CÀI ĐẶT THẺ ĐẶC QUYỀN & GIAO DIỆN</div>
            
            <div class="tab-container">
                <button class="tab-btn active" id="btn-tab-cards" onclick="switchTab('tab-cards')">🃏 Nội Dung & Biểu Tượng Thẻ</button>
                <button class="tab-btn" id="btn-tab-themes" onclick="switchTab('tab-themes')">🎨 Theme Background</button>
            </div>

            <!-- Tab 1: Tuỳ Chỉnh Nội Dung & Biểu Tượng Thẻ -->
            <div class="tab-content active" id="tab-cards">
                <div class="hint-text">
                    💡 Nhập Nội dung quà + Biểu tượng Emoji hoặc Link Ảnh URL tùy chỉnh tương ứng với từng Thẻ:
                </div>
                <div id="cardsConfigList" style="display: flex; flex-direction: column; gap: 10px;"></div>
            </div>

            <!-- Tab 2: Chọn Chủ Đề Background -->
            <div class="tab-content" id="tab-themes">
                <div class="theme-grid" id="themeGrid"></div>
            </div>

            <div class="config-footer">
                <button class="btn btn-reset" onclick="closeConfigModal()">Hủy</button>
                <button class="btn btn-claim" onclick="saveAllConfig()">Lưu Thay Đổi</button>
            </div>
        </div>
    </div>

    <script>
        // Danh sách 8 Đặc Quyền Mặc Định (Đã gắn liền Icon/Mặt Thẻ phù hợp)
        const defaultPrivileges = [
            {
                text: "Được làm Lớp Trưởng trong 1 tuần!",
                icon: "👑",
                label: "Quyền Lớp Trưởng",
                img: "👑" // Emoji hoặc Link Ảnh 3D Fluent
            },
            {
                text: "Miễn 1 lần kiểm tra bài cũ / bài tập!",
                icon: "📜",
                label: "Thẻ Miễn Trừ",
                img: "📜"
            },
            {
                text: "Được đổi chỗ ngồi theo ý thích 3 ngày!",
                icon: "🪑",
                label: "Ghế VIP Lớp Học",
                img: "🪑"
            },
            {
                text: "Nhận 1 phần quà bí mật từ Thầy/Cô!",
                icon: "🎁",
                label: "Hộp Quà Ma Thuật",
                img: "🎁"
            },
            {
                text: "Được cộng 1 điểm vào bài thi tới!",
                icon: "💯",
                label: "Điểm 10 May Mắn",
                img: "💯"
            },
            {
                text: "Được yêu cầu 1 bạn bất kỳ hát 1 bài!",
                icon: "🎤",
                label: "Micro Ca Sĩ",
                img: "🎤"
            },
            {
                text: "Làm Quản Trò giờ giải lao buổi hôm nay!",
                icon: "🎮",
                label: "Tay Cầm Game",
                img: "🎮"
            },
            {
                text: "Được miễn trực nhật lớp 1 buổi!",
                icon: "🧹",
                label: "Chổi Thần Kỳ",
                img: "🧹"
            }
        ];

        // Danh sách Themes Background
        const themesList = [
            { id: "cosmic", name: "Vũ Trụ Bí Ẩn", preview: "linear-gradient(135deg, #2b134d, #0a0515)" },
            { id: "classroom", name: "Lớp Học Vui Nhộn", preview: "linear-gradient(135deg, #1b4d3e, #061c15)" },
            { id: "candy", name: "Kẹo Ngọt Cute", preview: "linear-gradient(135deg, #591d48, #1f0518)" },
            { id: "sunset", name: "Hoàng Hôn Rực Rỡ", preview: "linear-gradient(135deg, #4d1938, #170412)" },
            { id: "ocean", name: "Đại Dương Sâu Thẫm", preview: "linear-gradient(135deg, #0f3443, #031017)" }
        ];

        // Load Dữ Liệu Lưu Trong LocalStorage
        let currentTheme = localStorage.getItem('privilege_app_theme') || 'cosmic';
        let privileges = JSON.parse(localStorage.getItem('classroom_privileges_data')) || defaultPrivileges;

        let eliminatedCards = new Set();
        let currentChosenIndex = null;
        let isAnimating = false;
        let currentBaseAngle = 0;

        const arena = document.getElementById('arena');
        const startBtn = document.getElementById('startBtn');

        // Âm thanh Synthesizer Web Audio API
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playWhooshSound() {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(180, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(700, audioCtx.currentTime + 0.12);
            gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.12);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.12);
        }

        function playFlipSound() {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(420, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(1050, audioCtx.currentTime + 0.2);
            gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.2);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.2);
        }

        function playVictorySound() {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const notes = [261.6, 329.6, 392.0, 523.3, 659.3];
            notes.forEach((freq, idx) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.1);
                gain.gain.setValueAtTime(0.3, audioCtx.currentTime + idx * 0.1);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.1 + 0.5);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start(audioCtx.currentTime + idx * 0.1);
                osc.stop(audioCtx.currentTime + idx * 0.1 + 0.5);
            });
        }

        // Bán kính Quỹ đạo Elip
        function getEllipseRadii() {
            const maxArenaWidth = Math.min(window.innerWidth - 60, 1300);
            return {
                rx: Math.max(maxArenaWidth * 0.44, 420),
                ry: 175
            };
        }

        // Cập nhật vị trí thẻ trên quỹ đạo Elip
        function updateCardsOnEllipse(baseAngle) {
            const { rx, ry } = getEllipseRadii();
            const activeIndices = [];
            privileges.forEach((_, idx) => {
                if (!eliminatedCards.has(idx) && idx !== currentChosenIndex) {
                    activeIndices.push(idx);
                }
            });

            activeIndices.forEach((cardIdx, i) => {
                const el = document.getElementById(`card-wrap-${cardIdx}`);
                if (!el) return;

                const angle = baseAngle + (i / activeIndices.length) * Math.PI * 2;
                const cosA = Math.cos(angle);
                const sinA = Math.sin(angle);

                const x = cosA * rx;
                const y = sinA * ry;

                const depthFactor = (sinA + 1) / 2;
                const scale = 0.72 + depthFactor * 0.38;
                const zIndex = Math.round(50 + depthFactor * 100);
                const tiltAngle = -cosA * 12;

                el.style.zIndex = zIndex;
                el.style.opacity = 0.55 + depthFactor * 0.45;
                el.style.transform = `translate(${x}px, ${y}px) rotate(${tiltAngle}deg) scale(${scale})`;
            });
        }

        // Kiểm tra xem chuỗi có phải là URL ảnh không
        function isImageURL(str) {
            return typeof str === 'string' && (str.startsWith('http://') || str.startsWith('https://') || str.startsWith('data:image'));
        }

        // Khởi tạo giao diện Thẻ
        function initCards() {
            arena.innerHTML = '';
            privileges.forEach((item, index) => {
                const wrapper = document.createElement('div');
                wrapper.className = 'card-wrapper';
                wrapper.id = `card-wrap-${index}`;

                // Tạo hiển thị Icon/Ảnh phù hợp với quà
                let avatarHTML = '';
                const displayImg = item.img || item.icon;
                if (isImageURL(displayImg)) {
                    avatarHTML = `<img src="${displayImg}" alt="${item.label || 'Đặc Quyền'}" class="privilege-img" onerror="this.onerror=null; this.src='https://placehold.co/100x100/ff758c/ffffff?text=Privilege';">`;
                } else {
                    avatarHTML = `<div class="privilege-emoji">${displayImg}</div>`;
                }

                wrapper.innerHTML = `
                    <div class="card-inner">
                        <!-- Mặt sau: Biểu tượng Đặc Quyền -->
                        <div class="card-face card-back">
                            <div class="privilege-avatar-container">
                                <div class="privilege-halo"></div>
                                ${avatarHTML}
                            </div>
                            <div class="card-badge-title">${item.label || 'Thẻ Đặc Quyền'}</div>
                            <div class="card-label">Thẻ số ${index + 1}</div>
                        </div>

                        <!-- Mặt trước: Nội dung Phần thưởng -->
                        <div class="card-face card-front">
                            <div class="reward-icon">${item.icon}</div>
                            <div class="reward-title">${item.text}</div>
                        </div>
                    </div>
                `;

                // Click thủ công vào thẻ
                wrapper.onclick = () => {
                    if (!isAnimating && !eliminatedCards.has(index)) {
                        pickAndRevealCard(index);
                    }
                };

                arena.appendChild(wrapper);
            });

            updateCardsOnEllipse(currentBaseAngle);
        }

        // ================= TRÌNH QUAY THẺ SHUFFLE =================
        function startShuffleAndAutoPick() {
            if (isAnimating) return;

            const activeIndices = [];
            privileges.forEach((_, idx) => {
                if (!eliminatedCards.has(idx)) activeIndices.push(idx);
            });

            if (activeIndices.length === 0) {
                alert("Tất cả thẻ đã được mở hết! Nhấn 'Đặt Lại Trò Chơi' để chơi ván mới nhé.");
                return;
            }

            if (activeIndices.length === 1) {
                pickAndRevealCard(activeIndices[0]);
                return;
            }

            isAnimating = true;
            startBtn.disabled = true;

            const startTime = performance.now();
            const duration = 2800; // 2.8s
            const initialAngle = currentBaseAngle;
            const totalRotation = Math.PI * 6; // 3 vòng
            let lastAudio = 0;

            function animate(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);

                const easeOutProgress = 1 - Math.pow(1 - progress, 3);
                currentBaseAngle = initialAngle + easeOutProgress * totalRotation;

                if (elapsed - lastAudio > 120 + progress * 160) {
                    playWhooshSound();
                    lastAudio = elapsed;
                }

                updateCardsOnEllipse(currentBaseAngle);

                if (progress < 1) {
                    requestAnimationFrame(animate);
                } else {
                    const chosenIndex = activeIndices[Math.floor(Math.random() * activeIndices.length)];
                    const chosenEl = document.getElementById(`card-wrap-${chosenIndex}`);

                    chosenEl.classList.add('targeted');

                    setTimeout(() => {
                        chosenEl.classList.remove('targeted');
                        pickAndRevealCard(chosenIndex);
                    }, 650);
                }
            }

            requestAnimationFrame(animate);
        }

        // Flip Thẻ và hiển thị Modal Quà
        function pickAndRevealCard(index) {
            isAnimating = true;
            startBtn.disabled = true;
            currentChosenIndex = index;

            const el = document.getElementById(`card-wrap-${index}`);

            el.classList.add('focus-center');
            playFlipSound();

            setTimeout(() => {
                el.classList.add('flipped');
                playVictorySound();

                confetti({
                    particleCount: 120,
                    spread: 100,
                    origin: { y: 0.55 }
                });

                setTimeout(() => {
                    document.getElementById('rewardEmoji').innerText = privileges[index].icon;
                    document.getElementById('rewardText').innerText = privileges[index].text;
                    document.getElementById('rewardModal').classList.add('active');
                }, 800);
            }, 300);
        }

        // Đóng modal thưởng và ẩn thẻ đã mở
        function closeReward() {
            document.getElementById('rewardModal').classList.remove('active');

            if (currentChosenIndex !== null) {
                const el = document.getElementById(`card-wrap-${currentChosenIndex}`);
                if (el) {
                    el.classList.remove('focus-center');
                    el.classList.add('eliminated');
                    eliminatedCards.add(currentChosenIndex);
                }
                currentChosenIndex = null;
            }

            updateCardsOnEllipse(currentBaseAngle);

            isAnimating = false;
            startBtn.disabled = false;
        }

        // Đặt lại trò chơi
        function resetGame() {
            if (isAnimating) return;
            eliminatedCards.clear();
            currentChosenIndex = null;
            currentBaseAngle = 0;

            document.querySelectorAll('.card-wrapper').forEach(el => {
                el.className = 'card-wrapper';
                el.style.opacity = 1;
            });

            updateCardsOnEllipse(currentBaseAngle);
            startShuffleAndAutoPick();
        }

        // ================= HỆ THỐNG CHỦ ĐỀ (THEMES) =================
        function applyTheme(themeId) {
            currentTheme = themeId;
            document.body.className = themeId === 'cosmic' ? '' : `theme-${themeId}`;
            localStorage.setItem('privilege_app_theme', themeId);
            renderThemeGrid();
        }

        function renderThemeGrid() {
            const grid = document.getElementById('themeGrid');
            grid.innerHTML = '';
            themesList.forEach(t => {
                const card = document.createElement('div');
                card.className = `theme-card ${currentTheme === t.id ? 'active' : ''}`;
                card.onclick = () => applyTheme(t.id);
                card.innerHTML = `
                    <div class="theme-preview" style="background: ${t.preview}"></div>
                    <div class="theme-card-name">${t.name}</div>
                `;
                grid.appendChild(card);
            });
        }

        // ================= CÀI ĐẶT THẺ & QUÀ =================
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            document.getElementById(`btn-${tabId}`).classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        function openConfigModal(defaultTab = 'tab-cards') {
            renderCardsConfigList();
            renderThemeGrid();
            switchTab(defaultTab);
            document.getElementById('configModal').classList.add('active');
        }

        function closeConfigModal() {
            document.getElementById('configModal').classList.remove('active');
        }

        function renderCardsConfigList() {
            const container = document.getElementById('cardsConfigList');
            container.innerHTML = '';
            privileges.forEach((item, idx) => {
                const row = document.createElement('div');
                row.className = 'config-item';
                row.innerHTML = `
                    <div class="label-idx">Thẻ ${idx + 1}:</div>
                    <input type="text" class="icon-input" id="cfg-icon-${idx}" value="${item.icon}" title="Emoji biểu tượng quà" maxlength="3">
                    <input type="text" class="text-input" id="cfg-text-${idx}" value="${item.text}" placeholder="Nội dung quà tặng">
                    <input type="text" class="text-input" id="cfg-img-${idx}" value="${item.img || ''}" placeholder="Link Ảnh URL / Emoji mặt thẻ">
                `;
                container.appendChild(row);
            });
        }

        function saveAllConfig() {
            // Lưu Danh sách Đặc quyền
            privileges.forEach((_, idx) => {
                const iconVal = document.getElementById(`cfg-icon-${idx}`).value.trim();
                const textVal = document.getElementById(`cfg-text-${idx}`).value.trim();
                const imgVal = document.getElementById(`cfg-img-${idx}`).value.trim();

                privileges[idx] = {
                    icon: iconVal || "🎁",
                    text: textVal || `Đặc quyền số ${idx + 1}`,
                    label: textVal ? textVal.substring(0, 15) + "..." : `Thẻ ${idx + 1}`,
                    img: imgVal || iconVal || "🎁"
                };
            });

            localStorage.setItem('classroom_privileges_data', JSON.stringify(privileges));

            closeConfigModal();
            initCards();
            resetGame();
        }

        window.addEventListener('resize', () => {
            if (!isAnimating) {
                updateCardsOnEllipse(currentBaseAngle);
            }
        });

        // Khởi tạo ban đầu
        applyTheme(currentTheme);
        initCards();
    </script>
</body>
</html>
